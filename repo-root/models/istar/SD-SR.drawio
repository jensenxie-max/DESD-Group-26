        <mxCell id="text_2" value="Sprint 2 • Draft for group review • 17 November 2026" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="131" width="592.8" height="26.599999999999998" />
        </mxCell>
        <mxCell id="text_3" value="Marketplace rationale: each capability has its own achievement goal." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1660" y="319" width="1060.8" height="36.4" />
        </mxCell>
        <mxCell id="text_4" value="Actor-level dependencies retain the same meaning and IDs as the SD view." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1660" y="367" width="950.4" height="30.799999999999997" />
        </mxCell>
        <mxCell id="text_5" value="01  Catalogue / F1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="483" width="300" height="37.8" />
        </mxCell>
        <mxCell id="text_6" value="Strategic: Task_F1, Task_CatalogResponse" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="1388" width="408.0" height="23.799999999999997" />
        </mxCell>
        <mxCell id="text_7" value="02  Inventory / F2" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2600" y="483" width="300" height="37.8" />
        </mxCell>
        <mxCell id="text_8" value="Strategic: Task_F2, Task_Visibility" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2600" y="1308" width="357.0" height="23.799999999999997" />
        </mxCell>
        <mxCell id="text_9" value="03  Orders and fulfilment" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="1433" width="405.0" height="37.8" />
        </mxCell>
        <mxCell id="text_10" value="Strategic: Task_Order, Task_Payment, Task_Fulfil, Task_Complete" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="2258" width="642.6" height="23.799999999999997" />
        </mxCell>
        <mxCell id="text_11" value="04  Finance and settlement" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2600" y="1433" width="421.2" height="37.8" />
        </mxCell>
        <mxCell id="text_12" value="Strategic: Task_Reconcile, Task_Settle, Task_Audit" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2600" y="2258" width="510.0" height="23.799999999999997" />
        </mxCell>
        <mxCell id="text_13" value="05  Quality and traceability" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="2283" width="453.59999999999997" height="37.8" />
        </mxCell>
        <mxCell id="text_14" value="Strategic: Task_Trace, Task_Investigate, Task_Respond, Task_Review" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="3108" width="673.1999999999999" height="23.799999999999997" />
        </mxCell>
        <mxCell id="text_15" value="06  Community and sustainability" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2600" y="2283" width="518.4" height="37.8" />
        </mxCell>
        <mxCell id="text_16" value="Strategic: Task_Surplus, Task_Content, Task_Miles" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2600" y="3108" width="499.79999999999995" height="23.799999999999997" />
        </mxCell>
        <mxCell id="text_17" value="Order branch: only after an order is accepted." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="1174" width="441.59999999999997" height="22.4" />
        </mxCell>
        <mxCell id="text_18" value="Concern branch: only when a concern is reported." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="2694" width="460.79999999999995" height="22.4" />
        </mxCell>
        <mxCell id="text_19" value="Boundary links intentionally refer to actors; no internal depender/dependee element is asserted. Rationale bindings are described in the model and traceability table." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=21;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="3199" width="2091.6" height="29.4" />
        </mxCell>
        <mxCell id="text_20" value="READING KEY" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="3258" width="300" height="30.799999999999997" />
        </mxCell>
        <mxCell id="text_21" value="D-shaped dependency markers point from the depender, through the dependum, to the dependee. This is dependency direction, not a message flow." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="3425" width="1692.0" height="28.0" />
        </mxCell>
        <mxCell id="text_22" value="SR: T-head = AND refinement; arrow = OR refinement; open circle = needed-by; help / hurt arrows express qualitative design judgements." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="3460" width="1608.0" height="28.0" />
        </mxCell>
        <mxCell id="text_23" value="SD and SR use the same 5 actors and 19 dependencies. F1/F2 are the operational focus; orders, finance, quality and community remain enterprise context." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="3495" width="1812.0" height="28.0" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>