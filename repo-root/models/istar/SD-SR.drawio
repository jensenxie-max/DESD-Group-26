        <mxCell id="text_0" value="BRISTOL REGIONAL FOOD NETWORK" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="35" width="522.0" height="42.0" />
        </mxCell>
        <mxCell id="text_1" value="Strategic Dependency (SD) • Whole-enterprise relationships" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="83" width="939.5999999999999" height="37.8" />
        </mxCell>
        <mxCell id="text_2" value="Sprint 2 • Draft for group review • 17 November 2026" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#66758a;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="131" width="592.8" height="26.599999999999998" />
        </mxCell>
        <mxCell id="text_3" value="F1: D01 / D02 / D13" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=23;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1250.0" y="1747" width="300" height="32.199999999999996" />
        </mxCell>
        <mxCell id="text_4" value="F2: D03 / D04 / D09" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=23;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1250.0" y="1787" width="300" height="32.199999999999996" />
        </mxCell>
        <mxCell id="text_5" value="D13 applies when organic certification is claimed." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130.0" y="1842" width="540.0" height="25.2" />
        </mxCell>
        <mxCell id="text_6" value="D11 / D17 apply when a concern is reported." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1167.8" y="1872" width="464.4" height="25.2" />
        </mxCell>
        <mxCell id="text_7" value="READING KEY" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#223248;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="2118" width="300" height="30.799999999999997" />
        </mxCell>
        <mxCell id="text_8" value="D-shaped dependency markers point from the depender, through the dependum, to the dependee. This is dependency direction, not a message flow." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="2285" width="1692.0" height="28.0" />
        </mxCell>
        <mxCell id="text_9" value="SR: T-head = AND refinement; arrow = OR refinement; open circle = needed-by; help / hurt arrows express qualitative design judgements." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="2320" width="1608.0" height="28.0" />
        </mxCell>
        <mxCell id="text_10" value="SD and SR use the same 5 actors and 19 dependencies. F1/F2 are the operational focus; orders, finance, quality and community remain enterprise context." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#223248;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="2355" width="1812.0" height="28.0" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
