<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_F1" targetNamespace="https://desd-group26.example/models" exporter="Camunda Web Modeler" exporterVersion="1921008" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="F1_Message_ProductDetails" name="Product details" />
  <bpmn:message id="F1_Message_CorrectedDetails" name="Corrected product details" />
  <bpmn:message id="F1_Message_Correction" name="Correction required" />
  <bpmn:message id="F1_Message_Publication" name="Listing published" />
  <bpmn:message id="F1_Message_Pending" name="Verification pending" />
  <bpmn:message id="F1_Message_CertificationRequest" name="Certification check request" />
  <bpmn:message id="F1_Message_CertificationResult" name="Certification result / failure" />
  <bpmn:collaboration id="F1_Collaboration">
    <bpmn:participant id="F1_Pool" name="BRISTOL REGIONAL FOOD NETWORK | F1" processRef="F1_Process" />
    <bpmn:participant id="F1_ProducerPool" name="PRODUCERS" processRef="F1_ProducerProcess" />
    <bpmn:participant id="F1_VerifierPool" name="Certification verification service (external or simulated)" />
    <bpmn:messageFlow id="F1_Msg_Submit" name="Product details" sourceRef="F1_SendDetails" targetRef="F1_ReceiveDetails" messageRef="F1_Message_ProductDetails" />
    <bpmn:messageFlow id="F1_Msg_Resubmit" name="Corrected details" sourceRef="F1_ResendDetails" targetRef="F1_ReceiveCorrected" messageRef="F1_Message_CorrectedDetails" />
    <bpmn:messageFlow id="F1_Msg_Correction" name="Correction request" sourceRef="F1_Correction" targetRef="F1_ProducerCorrection" messageRef="F1_Message_Correction" />
    <bpmn:messageFlow id="F1_Msg_Publication" name="Publication outcome" sourceRef="F1_Notify" targetRef="F1_ProducerPublished" messageRef="F1_Message_Publication" />
    <bpmn:messageFlow id="F1_Msg_Pending" name="Pending outcome" sourceRef="F1_PendingNotify" targetRef="F1_ProducerPending" messageRef="F1_Message_Pending" />
    <bpmn:messageFlow id="F1_Msg_CertRequest" name="Certification check" sourceRef="F1_Verify" targetRef="F1_VerifierPool" messageRef="F1_Message_CertificationRequest" />
    <bpmn:messageFlow id="F1_Msg_CertResult" name="Result / failure" sourceRef="F1_VerifierPool" targetRef="F1_Verify" messageRef="F1_Message_CertificationResult" />
  </bpmn:collaboration>
  <bpmn:process id="F1_ProducerProcess" name="Producer - Submit and correct product details" isExecutable="false">
    <bpmn:documentation>Registered producer submits product details and waits for the marketplace response. A correction request opens the existing correction form; corrected details are resubmitted and the producer waits again. Publication and pending verification are separate terminal outcomes. Authentication is a precondition; reminders and cancellation are outside this draft.</bpmn:documentation>
    <bpmn:sequenceFlow id="F1_Flow_21" name="Resubmitted" sourceRef="F1_Edit" targetRef="F1_ResendDetails" />
    <bpmn:sequenceFlow id="F1_Flow_02" sourceRef="F1_Submit" targetRef="F1_SendDetails" />
    <bpmn:sequenceFlow id="F1_Flow_01" sourceRef="F1_Start" targetRef="F1_Submit" />
    <bpmn:userTask id="F1_Edit" name="Correct and resubmit details">
      <bpmn:documentation>Producer corrects the information or certification claim. The initial draft waits for correction; reminder/cancellation policy is not assumed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="f1-correct-product-proposed" />
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:input source="= if lastSubmittedDetails != null then lastSubmittedDetails else details" target="details" />
          <zeebe:input source="= if lastSubmittedAllergenEntries != null then lastSubmittedAllergenEntries else if details.allergens = null then [] else for allergen in details.allergens return {name: allergen}" target="allergenEntries" />
          <zeebe:output source="= details" target="lastSubmittedDetails" />
          <zeebe:output source="= allergenEntries" target="lastSubmittedAllergenEntries" />
          <zeebe:output source="= context merge([{name: details.name, description: details.description, category: details.category, farmOrigin: details.farmOrigin, price: details.price, quantity: details.quantity, startDate: details.startDate, endDate: details.endDate, organicClaim: details.organicClaim = true, allergens: if allergenEntries = null then [] else for entry in allergenEntries return entry.name}, if details.certificationReference = null or details.certificationReference = &#34;&#34; then {} else {certificationReference: details.certificationReference}, if details.harvestDate = null or details.harvestDate = &#34;&#34; then {} else {harvestDate: details.harvestDate}, if details.bestBefore = null or details.bestBefore = &#34;&#34; then {} else {bestBefore: details.bestBefore}])" target="details" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1_ProducerFlow_Edit</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="F1_Submit" name="Submit product details">
      <bpmn:documentation>Registered producer enters name, description, category, price, quantity, availability period, farm origin and applicable harvest, allergen, organic certification and best-before information. Authentication is a precondition, not implemented in this draft.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="f1-submit-product-proposed" />
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:input source="= if details = null then {organicClaim: false} else details" target="details" />
          <zeebe:input source="= if details.allergens = null then [] else for allergen in details.allergens return {name: allergen}" target="allergenEntries" />
          <zeebe:output source="= details" target="lastSubmittedDetails" />
          <zeebe:output source="= allergenEntries" target="lastSubmittedAllergenEntries" />
          <zeebe:output source="= context merge([{name: details.name, description: details.description, category: details.category, farmOrigin: details.farmOrigin, price: details.price, quantity: details.quantity, startDate: details.startDate, endDate: details.endDate, organicClaim: details.organicClaim = true, allergens: if allergenEntries = null then [] else for entry in allergenEntries return entry.name}, if details.certificationReference = null or details.certificationReference = &#34;&#34; then {} else {certificationReference: details.certificationReference}, if details.harvestDate = null or details.harvestDate = &#34;&#34; then {} else {harvestDate: details.harvestDate}, if details.bestBefore = null or details.bestBefore = &#34;&#34; then {} else {bestBefore: details.bestBefore}])" target="details" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Flow_01</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="F1_Start" name="Listing started">
      <bpmn:outgoing>F1_Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="F1_SendDetails" name="Send product details">
      <bpmn:incoming>F1_Flow_02</bpmn:incoming>
      <bpmn:outgoing>F1_ProducerFlow_Submitted</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="F1_ProducerAwaitMerge">
      <bpmn:incoming>F1_ProducerFlow_Submitted</bpmn:incoming>
      <bpmn:incoming>F1_ProducerFlow_Resubmitted</bpmn:incoming>
      <bpmn:outgoing>F1_ProducerFlow_Await</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="F1_WaitOutcome" name="Wait for marketplace response">
      <bpmn:incoming>F1_ProducerFlow_Await</bpmn:incoming>
      <bpmn:outgoing>F1_ProducerFlow_Correction</bpmn:outgoing>
      <bpmn:outgoing>F1_ProducerFlow_Publication</bpmn:outgoing>
      <bpmn:outgoing>F1_ProducerFlow_Pending</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="F1_ProducerCorrection" name="Correction requested">
      <bpmn:incoming>F1_ProducerFlow_Correction</bpmn:incoming>
      <bpmn:outgoing>F1_ProducerFlow_Edit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="F1_ProducerCorrection_definition" messageRef="F1_Message_Correction" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="F1_ResendDetails" name="Send corrected details">
      <bpmn:incoming>F1_Flow_21</bpmn:incoming>
      <bpmn:outgoing>F1_ProducerFlow_Resubmitted</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="F1_ProducerPublished" name="Publication confirmed">
      <bpmn:incoming>F1_ProducerFlow_Publication</bpmn:incoming>
      <bpmn:outgoing>F1_ProducerFlow_PublishedEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="F1_ProducerPublished_definition" messageRef="F1_Message_Publication" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="F1_ProducerPublishedEnd" name="Listing publication received">
      <bpmn:incoming>F1_ProducerFlow_PublishedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="F1_ProducerPending" name="Pending status received">
      <bpmn:incoming>F1_ProducerFlow_Pending</bpmn:incoming>
      <bpmn:outgoing>F1_ProducerFlow_PendingEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="F1_ProducerPending_definition" messageRef="F1_Message_Pending" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="F1_ProducerPendingEnd" name="Await verification follow-up">
      <bpmn:incoming>F1_ProducerFlow_PendingEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1_ProducerFlow_Submitted" sourceRef="F1_SendDetails" targetRef="F1_ProducerAwaitMerge" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_Resubmitted" sourceRef="F1_ResendDetails" targetRef="F1_ProducerAwaitMerge" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_Await" sourceRef="F1_ProducerAwaitMerge" targetRef="F1_WaitOutcome" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_Correction" sourceRef="F1_WaitOutcome" targetRef="F1_ProducerCorrection" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_Edit" sourceRef="F1_ProducerCorrection" targetRef="F1_Edit" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_Publication" sourceRef="F1_WaitOutcome" targetRef="F1_ProducerPublished" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_PublishedEnd" sourceRef="F1_ProducerPublished" targetRef="F1_ProducerPublishedEnd" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_Pending" sourceRef="F1_WaitOutcome" targetRef="F1_ProducerPending" />
    <bpmn:sequenceFlow id="F1_ProducerFlow_PendingEnd" sourceRef="F1_ProducerPending" targetRef="F1_ProducerPendingEnd" />
  </bpmn:process>
  <bpmn:process id="F1_Process" name="F1 - Marketplace product validation and publication" isExecutable="false">
    <bpmn:documentation>Operational responsibility model, 17 November 2026. Producer tasks are in an independent participant; platform responsibilities follow the strategic Catalogue and producer support and Inventory and availability lanes. Existing validation, organic-claim, certification, correction, publication and pending outcomes are retained. Producer form definitions and field mappings are unchanged. Cross-participant interactions are messages. This design is not deployed: message correlation, workers and gateway conditions remain unconfigured. Certification is an abstract synchronous request/response, including unavailable/timeout status; its external or simulated provider is shown as a black-box participant. Publication still requires a separate sale-availability calculation. Full order and payment processing are excluded.</bpmn:documentation>
    <bpmn:laneSet id="F1_LaneSet">
      <bpmn:lane id="F1_Lane_Catalogue" name="Catalogue and producer support">
        <bpmn:flowNodeRef>Gateway_1tq8q8b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_PendingEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_PendingNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Correction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_Entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_ReceiveDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1_ReceiveCorrected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="F1_Lane_Inventory" name="Inventory and availability">
        <bpmn:flowNodeRef>F1_Availability</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="F1_Flow_12" sourceRef="F1_PendingNotify" targetRef="F1_PendingEnd" />
    <bpmn:sequenceFlow id="F1_Flow_11" sourceRef="F1_Pending" targetRef="F1_PendingNotify" />
    <bpmn:sequenceFlow id="F1_Flow_20" sourceRef="F1_Correction" targetRef="F1_ReceiveCorrected" />
    <bpmn:sequenceFlow id="Flow_1hnym9h" sourceRef="Gateway_1tq8q8b" targetRef="F1_Correction" />
    <bpmn:sequenceFlow id="F1_Flow_10" sourceRef="F1_Notify" targetRef="F1_End" />
    <bpmn:sequenceFlow id="F1_Flow_09" sourceRef="F1_Availability" targetRef="F1_Notify" />
    <bpmn:sequenceFlow id="F1_Flow_08" sourceRef="F1_Publish" targetRef="F1_Availability" />
    <bpmn:sequenceFlow id="F1_Flow_07" sourceRef="F1_Ready" targetRef="F1_Publish" />
    <bpmn:sequenceFlow id="Flow_0tt0k2k" name="Invalid certification" sourceRef="F1_Result" targetRef="Gateway_1tq8q8b" />
    <bpmn:sequenceFlow id="F1_Flow_19" name="Unavailable" sourceRef="F1_Result" targetRef="F1_Pending" />
    <bpmn:sequenceFlow id="F1_Flow_16" name="Verified" sourceRef="F1_Result" targetRef="F1_Ready" />
    <bpmn:sequenceFlow id="F1_Flow_06" sourceRef="F1_Verify" targetRef="F1_Result" />
    <bpmn:sequenceFlow id="F1_Flow_15" name="No claim" sourceRef="F1_Claim" targetRef="F1_Ready" />
    <bpmn:sequenceFlow id="F1_Flow_05" name="Yes" sourceRef="F1_Claim" targetRef="F1_Verify" />
    <bpmn:sequenceFlow id="Flow_1ql8ek8" name="No" sourceRef="F1_Valid" targetRef="Gateway_1tq8q8b" />
    <bpmn:sequenceFlow id="F1_Flow_13" name="Yes" sourceRef="F1_Valid" targetRef="F1_Claim" />
    <bpmn:sequenceFlow id="F1_Flow_04" sourceRef="F1_Validate" targetRef="F1_Valid" />
    <bpmn:sequenceFlow id="F1_Flow_03" sourceRef="F1_Entry" targetRef="F1_Validate" />
    <bpmn:exclusiveGateway id="Gateway_1tq8q8b">
      <bpmn:incoming>Flow_0tt0k2k</bpmn:incoming>
      <bpmn:incoming>Flow_1ql8ek8</bpmn:incoming>
      <bpmn:outgoing>Flow_1hnym9h</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="F1_PendingEnd" name="Verification follow-up recorded">
      <bpmn:incoming>F1_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="F1_PendingNotify" name="Notify producer of pending status">
      <bpmn:incoming>F1_Flow_11</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="F1_Pending" name="Record pending verification">
      <bpmn:documentation>Keep listing unpublished, record verification failure reason and follow-up state. This is an unresolved business outcome, not successful publication. Retry policy will be designed next week.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_19</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="F1_Correction" name="Request corrected details">
      <bpmn:documentation>Explain missing or invalid fields or the failed certification claim. Keep listing unpublished. A producer may correct evidence or remove an unsupported organic claim; all submitted information is revalidated.</bpmn:documentation>
      <bpmn:incoming>Flow_1hnym9h</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="F1_End" name="Listing published">
      <bpmn:incoming>F1_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="F1_Notify" name="Notify producer of publication">
      <bpmn:documentation>Send the listing result to the producer. Notification delivery failure handling remains a later implementation concern.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_09</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="F1_Availability" name="Set initial sale availability">
      <bpmn:documentation>Initial availability requires published listing, quantity greater than zero and current business date within the selling period. No sale before the period begins. This calculation is shared with F2.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_08</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F1_Publish" name="Publish validated listing">
      <bpmn:documentation>Only valid required information and a verified claim, or no organic claim, reach publication. Persist product identity and validated details.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_07</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_Ready" name="">
      <bpmn:incoming>F1_Flow_16</bpmn:incoming>
      <bpmn:incoming>F1_Flow_15</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="F1_Result" name="Verification outcome?">
      <bpmn:incoming>F1_Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_0tt0k2k</bpmn:outgoing>
      <bpmn:outgoing>F1_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>F1_Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F1_Verify" name="Check certification with provider">
      <bpmn:documentation>External or simulated certification verification. Return one of verified, invalid, unavailable; unavailable includes timeout. No connector or worker exists yet. Do not treat an outage as a failed certificate.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_05</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_Claim" name="Organic claim?">
      <bpmn:incoming>F1_Flow_13</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_15</bpmn:outgoing>
      <bpmn:outgoing>F1_Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="F1_Valid" name="Information valid?">
      <bpmn:incoming>F1_Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_1ql8ek8</bpmn:outgoing>
      <bpmn:outgoing>F1_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F1_Validate" name="Validate required information">
      <bpmn:documentation>Marketplace validates required fields, applicable information, quantity and price ranges and date ordering. Exact field-level constraints need group review. Corrected information is revalidated.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_03</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_Entry" name="">
      <bpmn:incoming>F1_PlatformFlow_Received</bpmn:incoming>
      <bpmn:incoming>F1_PlatformFlow_Corrected</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="F1_ReceiveDetails" name="Product details received">
      <bpmn:outgoing>F1_PlatformFlow_Received</bpmn:outgoing>
      <bpmn:messageEventDefinition id="F1_ReceiveDetails_definition" messageRef="F1_Message_ProductDetails" />
    </bpmn:startEvent>
    <bpmn:receiveTask id="F1_ReceiveCorrected" name="Receive corrected details" messageRef="F1_Message_CorrectedDetails">
      <bpmn:incoming>F1_Flow_20</bpmn:incoming>
      <bpmn:outgoing>F1_PlatformFlow_Corrected</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="F1_PlatformFlow_Received" sourceRef="F1_ReceiveDetails" targetRef="F1_Entry" />
    <bpmn:sequenceFlow id="F1_PlatformFlow_Corrected" sourceRef="F1_ReceiveCorrected" targetRef="F1_Entry" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="F1_Diagram">
    <bpmndi:BPMNPlane id="F1_Plane" bpmnElement="F1_Collaboration">
      <bpmndi:BPMNShape id="F1_Pool_di" bpmnElement="F1_Pool" isHorizontal="true">
        <dc:Bounds x="0" y="600" width="3000" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Lane_Inventory_di" bpmnElement="F1_Lane_Inventory" isHorizontal="true">
        <dc:Bounds x="30" y="1150" width="2970" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Lane_Catalogue_di" bpmnElement="F1_Lane_Catalogue" isHorizontal="true">
        <dc:Bounds x="30" y="600" width="2970" height="550" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1tq8q8b_di" bpmnElement="Gateway_1tq8q8b" isMarkerVisible="true">
        <dc:Bounds x="1030" y="975" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_PendingEnd_di" bpmnElement="F1_PendingEnd">
        <dc:Bounds x="2850" y="1082" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2785" y="1122" width="170" height="26" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_PendingNotify_di" bpmnElement="F1_PendingNotify">
        <dc:Bounds x="2610" y="1060" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Pending_di" bpmnElement="F1_Pending">
        <dc:Bounds x="1850" y="1060" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Correction_di" bpmnElement="F1_Correction">
        <dc:Bounds x="1120" y="960" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_End_di" bpmnElement="F1_End">
