        <dc:Bounds x="1020" y="600" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inventory_End_di" bpmnElement="Inventory_End">
        <dc:Bounds x="2010" y="622" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1968" y="666" width="120" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Orders_Start_di" bpmnElement="Orders_Start">
        <dc:Bounds x="540" y="897" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="941" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Order_di" bpmnElement="Task_Order">
        <dc:Bounds x="700" y="875" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Payment_di" bpmnElement="Task_Payment">
        <dc:Bounds x="1020" y="875" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fulfil_di" bpmnElement="Task_Fulfil">
        <dc:Bounds x="1340" y="875" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Complete_di" bpmnElement="Task_Complete">
        <dc:Bounds x="1660" y="875" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Orders_End_di" bpmnElement="Orders_End">
        <dc:Bounds x="2010" y="897" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1968" y="941" width="120" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Finance_Start_di" bpmnElement="Finance_Start">
        <dc:Bounds x="540" y="1192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="1236" width="120" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reconcile_di" bpmnElement="Task_Reconcile">
        <dc:Bounds x="700" y="1170" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Settle_di" bpmnElement="Task_Settle">
        <dc:Bounds x="1020" y="1170" width="220" height="80" />
