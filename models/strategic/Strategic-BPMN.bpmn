<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Sprint1Learning" targetNamespace="https://example.org/desd-group26/learning" exporter="Camunda Web Modeler" exporterVersion="5acd1b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_FoodNetwork">
    <bpmn:participant id="Participant_Network" name="BRISTOL REGIONAL FOOD NETWORK" processRef="Process_Strategic" />
    <bpmn:participant id="Participant_Producer" name="PRODUCERS" />
    <bpmn:participant id="Participant_Verifier" name="Certification verification service (external or simulated)" />
    <bpmn:participant id="Participant_Customers" name="CUSTOMERS / COMMUNITY BUYERS" />
    <bpmn:participant id="Participant_Payments" name="Payment / settlement service (sandbox)" />
    <bpmn:messageFlow id="Msg_Listing" name="Product details" sourceRef="Participant_Producer" targetRef="Catalog_Start" />
    <bpmn:messageFlow id="Msg_Updates" name="Stock / season updates" sourceRef="Participant_Producer" targetRef="Inventory_Start" />
    <bpmn:messageFlow id="Msg_ListingReply" name="Listing outcome" sourceRef="Task_CatalogResponse" targetRef="Participant_Producer" />
    <bpmn:messageFlow id="Msg_Verify" name="Certification check (when claimed)" sourceRef="Task_F1" targetRef="Participant_Verifier" />
    <bpmn:messageFlow id="Msg_Verified" name="Verification result / failure" sourceRef="Participant_Verifier" targetRef="Task_F1" />
    <bpmn:messageFlow id="Msg_Order" name="Order request" sourceRef="Participant_Customers" targetRef="Orders_Start" />
    <bpmn:messageFlow id="Msg_OrderReply" name="Order outcome" sourceRef="Task_Complete" targetRef="Participant_Customers" />
    <bpmn:messageFlow id="Msg_PayRequest" name="Payment request" sourceRef="Task_Payment" targetRef="Participant_Payments" />
    <bpmn:messageFlow id="Msg_PayResult" name="Payment result" sourceRef="Participant_Payments" targetRef="Task_Payment" />
    <bpmn:messageFlow id="Msg_Fulfil" name="Producer-specific order / preparation notice" sourceRef="Task_Fulfil" targetRef="Participant_Producer" />
    <bpmn:messageFlow id="Msg_Settle" name="Settlement instruction" sourceRef="Task_Settle" targetRef="Participant_Payments" />
    <bpmn:messageFlow id="Msg_Incident" name="Quality concern" sourceRef="Participant_Customers" targetRef="Quality_Start" />
    <bpmn:messageFlow id="Msg_Alert" name="Affected-customer notice / follow-up" sourceRef="Task_Respond" targetRef="Participant_Customers" />
    <bpmn:messageFlow id="Msg_Content" name="Offers / education / sustainability information" sourceRef="Task_Miles" targetRef="Participant_Customers" />
    <bpmn:textAnnotation id="Note_Title">
      <bpmn:text>SPRINT 1 | Enterprise strategic process overview
Enterprise scope, responsibilities, interactions and candidate scope.
Independent business cycles; high-level tasks abstract detailed decisions and exceptions.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Scope">
      <bpmn:text>BLUE ACTIVITIES = selected Use Case 1 candidates
F1: validation and publishing. F2: inventory and seasonal availability.
Tutor agreement: PENDING. Detailed executable processes: Sprint 2 / 3.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_Strategic" name="Enterprise strategic overview" isExecutable="false">
    <bpmn:documentation>Strategic scope covers the whole enterprise. Rows are independent event-triggered business cycles. Task boxes denote high-level business capabilities; detailed operational paths and executable configuration belong to later sprints. Candidate F1/F2 require tutor agreement. Lane ownership is a proposed responsibility allocation, not a case-study fact.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Enterprise">
      <bpmn:lane id="Lane_Community" name="Community and sustainability">
        <bpmn:flowNodeRef>Community_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Surplus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Miles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Community_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Quality" name="Quality and traceability">
        <bpmn:flowNodeRef>Quality_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Trace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Respond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Quality_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance and settlement">
        <bpmn:flowNodeRef>Finance_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Finance_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orders" name="Order and fulfilment coordination">
        <bpmn:flowNodeRef>Orders_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fulfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orders_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Inventory" name="Inventory and availability">
        <bpmn:flowNodeRef>Inventory_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Visibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inventory_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Catalogue" name="Catalogue and producer support">
        <bpmn:flowNodeRef>Catalog_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_F1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CatalogResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catalog_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Catalog_Start" name="Listing request received">
      <bpmn:outgoing>Catalog_Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catalog_Start_definition" />
    </bpmn:startEvent>
    <bpmn:task id="Task_F1" name="F1 | Validate and publish product">
      <bpmn:documentation>Candidate major functionality F1. Includes mandatory-field validation, correction loop, conditional organic certification verification, failure/unavailable-service handling and publication only after validation. A strategic activity does not assert that every request succeeds. Scope: Use Cases p1; case study pp1-2.</bpmn:documentation>
      <bpmn:incoming>Catalog_Flow_0</bpmn:incoming>
      <bpmn:outgoing>Catalog_Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CatalogResponse" name="Communicate listing outcome">
      <bpmn:incoming>Catalog_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Catalog_Flow_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Catalog_End" name="Listing request handled">
      <bpmn:incoming>Catalog_Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Inventory_Start" name="Stock / availability update received">
      <bpmn:outgoing>Inventory_Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Inventory_Start_definition" />
    </bpmn:startEvent>
    <bpmn:task id="Task_F2" name="F2 | Manage stock and seasonal availability">
      <bpmn:documentation>Candidate major functionality F2. Producer updates and confirmed-order deductions affect quantities. Zero stock makes product unavailable; replenishment reactivates it only within its availability period. Expiry handling is a proposed design rule. Detailed concurrency and exception paths belong to the operational model.</bpmn:documentation>
      <bpmn:incoming>Inventory_Flow_0</bpmn:incoming>
      <bpmn:outgoing>Inventory_Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Visibility" name="Synchronise customer-facing availability">
      <bpmn:incoming>Inventory_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Inventory_Flow_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Inventory_End" name="Availability updated">
      <bpmn:incoming>Inventory_Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Orders_Start" name="Customer order received">
      <bpmn:outgoing>Orders_Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Orders_Start_definition" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Order" name="Manage basket, availability and checkout">
      <bpmn:documentation>Enterprise context, not a third selected implementation functionality. Include product search/browsing before ordering, multi-vendor allocation and stock checks.</bpmn:documentation>
      <bpmn:incoming>Orders_Flow_0</bpmn:incoming>
      <bpmn:outgoing>Orders_Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Payment" name="Manage payment and order confirmation">
      <bpmn:documentation>Use sandbox/simulated payment; unsuccessful payments and service outages handled inside this high-level capability. Confirmed orders update inventory.</bpmn:documentation>
      <bpmn:incoming>Orders_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Orders_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Fulfil" name="Coordinate producer fulfilment and collection / delivery">
      <bpmn:documentation>Communicate producer-specific responsibilities and allow the minimum 48-hour preparation lead time from the case study. Delivery may be producer-led or collection; no separate courier is assumed.</bpmn:documentation>
      <bpmn:incoming>Orders_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Orders_Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Complete" name="Record completion and customer outcome">
      <bpmn:incoming>Orders_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Orders_Flow_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Orders_End" name="Order handled">
      <bpmn:incoming>Orders_Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Finance_Start" name="Weekly settlement due">
      <bpmn:outgoing>Finance_Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Finance_Start_definition">
        <bpmn:timeCycle>R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Task_Reconcile" name="Reconcile sales and calculate 5% commission">
      <bpmn:incoming>Finance_Flow_0</bpmn:incoming>
      <bpmn:outgoing>Finance_Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Settle" name="Settle producer balances">
      <bpmn:documentation>Weekly settlement required. Failed transfers/reconciliation issues require follow-up; detailed paths deferred. Test payment systems only.</bpmn:documentation>
      <bpmn:incoming>Finance_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Finance_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Audit" name="Maintain statements and audit trail">
      <bpmn:incoming>Finance_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Finance_Flow_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Finance_End" name="Settlement cycle handled">
      <bpmn:incoming>Finance_Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Quality_Start" name="Quality concern received">
      <bpmn:outgoing>Quality_Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Quality_Start_definition" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Trace" name="Identify affected products, producers and orders">
      <bpmn:incoming>Quality_Flow_0</bpmn:incoming>
      <bpmn:outgoing>Quality_Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Investigate" name="Investigate risk and decide response">
      <bpmn:incoming>Quality_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Quality_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Respond" name="Coordinate suspension, notification and follow-up">
      <bpmn:documentation>If risk is confirmed, suspend sale where appropriate, notify affected customers and record outcomes. Failed notifications need alternate/manual follow-up. If no genuine risk is found, closure is possible without notifications. These branches are abstracted at strategic level.</bpmn:documentation>
      <bpmn:incoming>Quality_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Quality_Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Review" name="Review actions and close or request more work">
      <bpmn:incoming>Quality_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Quality_Flow_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Quality_End" name="Incident handled">
      <bpmn:incoming>Quality_Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Community_Start" name="Community / reporting cycle starts">
      <bpmn:outgoing>Community_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Surplus" name="Coordinate surplus offers and discounts">
      <bpmn:incoming>Community_Flow_0</bpmn:incoming>
      <bpmn:outgoing>Community_Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Content" name="Share recipes, storage advice and farm stories">
      <bpmn:incoming>Community_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Community_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Miles" name="Report food miles and sustainability">
      <bpmn:documentation>Postcode-based distance measurement is required by the case study. Trigger and sequential arrangement are illustrative assumptions; these capabilities may operate independently.</bpmn:documentation>
      <bpmn:incoming>Community_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Community_Flow_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Community_End" name="Community cycle completed">
      <bpmn:incoming>Community_Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Catalog_Flow_0" sourceRef="Catalog_Start" targetRef="Task_F1" />
    <bpmn:sequenceFlow id="Catalog_Flow_1" sourceRef="Task_F1" targetRef="Task_CatalogResponse" />
    <bpmn:sequenceFlow id="Catalog_Flow_End" sourceRef="Task_CatalogResponse" targetRef="Catalog_End" />
    <bpmn:sequenceFlow id="Inventory_Flow_0" sourceRef="Inventory_Start" targetRef="Task_F2" />
    <bpmn:sequenceFlow id="Inventory_Flow_1" sourceRef="Task_F2" targetRef="Task_Visibility" />
    <bpmn:sequenceFlow id="Inventory_Flow_End" sourceRef="Task_Visibility" targetRef="Inventory_End" />
    <bpmn:sequenceFlow id="Orders_Flow_0" sourceRef="Orders_Start" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="Orders_Flow_1" sourceRef="Task_Order" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Orders_Flow_2" sourceRef="Task_Payment" targetRef="Task_Fulfil" />
    <bpmn:sequenceFlow id="Orders_Flow_3" sourceRef="Task_Fulfil" targetRef="Task_Complete" />
    <bpmn:sequenceFlow id="Orders_Flow_End" sourceRef="Task_Complete" targetRef="Orders_End" />
    <bpmn:sequenceFlow id="Finance_Flow_0" sourceRef="Finance_Start" targetRef="Task_Reconcile" />
    <bpmn:sequenceFlow id="Finance_Flow_1" sourceRef="Task_Reconcile" targetRef="Task_Settle" />
    <bpmn:sequenceFlow id="Finance_Flow_2" sourceRef="Task_Settle" targetRef="Task_Audit" />
    <bpmn:sequenceFlow id="Finance_Flow_End" sourceRef="Task_Audit" targetRef="Finance_End" />
    <bpmn:sequenceFlow id="Quality_Flow_0" sourceRef="Quality_Start" targetRef="Task_Trace" />
    <bpmn:sequenceFlow id="Quality_Flow_1" sourceRef="Task_Trace" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Quality_Flow_2" sourceRef="Task_Investigate" targetRef="Task_Respond" />
    <bpmn:sequenceFlow id="Quality_Flow_3" sourceRef="Task_Respond" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Quality_Flow_End" sourceRef="Task_Review" targetRef="Quality_End" />
    <bpmn:sequenceFlow id="Community_Flow_0" sourceRef="Community_Start" targetRef="Task_Surplus" />
    <bpmn:sequenceFlow id="Community_Flow_1" sourceRef="Task_Surplus" targetRef="Task_Content" />
    <bpmn:sequenceFlow id="Community_Flow_2" sourceRef="Task_Content" targetRef="Task_Miles" />
    <bpmn:sequenceFlow id="Community_Flow_End" sourceRef="Task_Miles" targetRef="Community_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Strategic">
    <bpmndi:BPMNPlane id="Plane_Strategic" bpmnElement="Collaboration_FoodNetwork">
      <bpmndi:BPMNShape id="Participant_Network_di" bpmnElement="Participant_Network" isHorizontal="true" color:background-color="#ffffff">
        <dc:Bounds x="430" y="240" width="1900" height="1650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Community_di" bpmnElement="Lane_Community" isHorizontal="true" color:background-color="#ffffff">
        <dc:Bounds x="460" y="1630" width="1870" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Quality_di" bpmnElement="Lane_Quality" isHorizontal="true" color:background-color="#f8fafc">
        <dc:Bounds x="460" y="1340" width="1870" height="290" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true" color:background-color="#ffffff">
        <dc:Bounds x="460" y="1080" width="1870" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Orders_di" bpmnElement="Lane_Orders" isHorizontal="true" color:background-color="#f8fafc">
        <dc:Bounds x="460" y="780" width="1870" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Inventory_di" bpmnElement="Lane_Inventory" isHorizontal="true" color:background-color="#ffffff">
        <dc:Bounds x="460" y="510" width="1870" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Catalogue_di" bpmnElement="Lane_Catalogue" isHorizontal="true" color:background-color="#f8fafc">
        <dc:Bounds x="460" y="240" width="1870" height="270" />
      </bpmndi:BPMNShape>
