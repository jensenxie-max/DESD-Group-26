{
  "components": [
    {
      "type": "text",
      "id": "Text_F2_Title",
      "text": "## Update stock and sale dates",
      "layout": {
        "row": "row_0",
        "columns": null
      }
    },
    {
      "type": "text",
      "id": "Text_F2_Intro",
      "text": "Enter the new total stock quantity and the product selling period.",
      "layout": {
        "row": "row_1",
        "columns": null
      }
    },
    {
      "type": "textfield",
      "id": "Field_F2_ProductId",
      "key": "display.productId",
      "label": "Product",
      "layout": {
        "row": "row_2",
        "columns": null
      },
      "readonly": true
    },
    {
      "type": "number",
      "id": "Field_F2_CurrentQuantity",
      "key": "display.quantity",
      "label": "Current quantity",
      "layout": {
        "row": "row_3",
        "columns": null
      },
      "readonly": true,
      "decimalDigits": 0,
      "serializeToString": false
    },
    {
      "type": "number",
      "id": "Field_F2_Version",
      "key": "display.version",
      "label": "Current version",
      "layout": {
        "row": "row_3",
        "columns": null
      },
      "readonly": true,
      "decimalDigits": 0,
      "serializeToString": false
    },
    {
      "type": "number",
      "id": "Field_F2_NewQuantity",
      "key": "producerQuantity",
      "label": "New quantity (whole units)",
      "layout": {
        "row": "row_4",
        "columns": null
      },
      "validate": {
        "required": true,
        "min": 0
      },
      "decimalDigits": 0,
      "increment": 1,
      "serializeToString": false
    },
    {
      "type": "datetime",
      "id": "Field_F2_StartDate",
      "key": "producerStartDate",
      "label": "Sale start date",
      "layout": {
        "row": "row_5",
        "columns": null
      },
      "validate": {
        "required": true
      },
      "subtype": "date",
      "dateLabel": "Sale start date"
    },
    {
      "type": "datetime",
      "id": "Field_F2_EndDate",
      "key": "producerEndDate",
      "label": "Sale end date",
      "layout": {
        "row": "row_5",
        "columns": null
      },
      "validate": {
        "required": true
      },
      "subtype": "date",
      "dateLabel": "Sale end date"
    },
    {
      "type": "text",
      "id": "Text_F2_Help",
      "text": "Enter the new total quantity, not an amount to add. The sale end date must be on or after the start date.",
      "layout": {
        "row": "row_6",
        "columns": null
      }
    },
    {
      "type": "button",
      "id": "Button_F2_Submit",
      "label": "Submit stock update",
      "action": "submit",
      "layout": {
        "row": "row_7",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "f2-stock-dates-proposed",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "schemaVersion": 19,
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "61e4b3b"
  }
}
