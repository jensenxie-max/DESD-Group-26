{
  "components": [
    {
      "type": "text",
      "id": "Text_Correct_Title",
      "text": "## Correct product details",
      "layout": {
        "row": "row_0",
        "columns": null
      }
    },
    {
      "type": "text",
      "id": "Text_Correct_Intro",
      "text": "Review the feedback, update the details below, and resubmit.",
      "layout": {
        "row": "row_1",
        "columns": null
      }
    },
    {
      "type": "table",
      "id": "Table_CorrectionErrors",
      "label": "Details to correct",
      "dataSource": "= if validationErrors = null then [] else validationErrors",
      "columns": [
        {
          "label": "Field",
          "key": "field"
        },
        {
          "label": "What to change",
          "key": "message"
        }
      ],
      "rowCount": 10,
      "layout": {
        "row": "row_2",
        "columns": null
      }
    },
    {
      "type": "textfield",
      "id": "Field_Correct_Name",
      "key": "details.name",
      "label": "Product name",
      "layout": {
        "row": "row_3",
        "columns": null
      },
      "validate": {
        "required": true
      }
    },
    {
      "type": "textarea",
      "id": "Field_Correct_Description",
      "key": "details.description",
      "label": "Description",
      "layout": {
        "row": "row_4",
        "columns": null
      },
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "id": "Field_Correct_Category",
      "key": "details.category",
      "label": "Category",
      "layout": {
        "row": "row_5",
        "columns": null
      },
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "id": "Field_Correct_Origin",
      "key": "details.farmOrigin",
      "label": "Farm origin",
      "layout": {
        "row": "row_5",
        "columns": null
      },
      "validate": {
        "required": true
      }
    },
    {
      "type": "number",
      "id": "Field_Correct_Price",
      "key": "details.price",
      "label": "Price",
      "layout": {
        "row": "row_6",
        "columns": null
      },
      "validate": {
        "required": true,
        "min": 0
      },
      "serializeToString": false
    },
    {
      "type": "number",
      "id": "Field_Correct_Quantity",
      "key": "details.quantity",
      "label": "Quantity (whole units)",
      "layout": {
        "row": "row_6",
        "columns": null
      },
      "validate": {
        "required": true,
        "min": 0
      },
      "decimalDigits": 0,
      "increment": 1,
      "serializeToString": false
    },
    {
      "type": "datetime",
      "id": "Field_Correct_StartDate",
      "key": "details.startDate",
      "label": "Sale start date",
      "layout": {
        "row": "row_7",
        "columns": null
      },
      "validate": {
        "required": true
      },
      "subtype": "date",
      "dateLabel": "Sale start date"
    },
    {
      "type": "datetime",
      "id": "Field_Correct_EndDate",
      "key": "details.endDate",
      "label": "Sale end date",
      "layout": {
        "row": "row_7",
        "columns": null
      },
      "validate": {
        "required": true
      },
      "subtype": "date",
      "dateLabel": "Sale end date"
    },
    {
      "type": "text",
      "id": "Text_Correct_DateHelp",
      "text": "The sale end date must be on or after the sale start date.",
      "layout": {
        "row": "row_8",
        "columns": null
      }
    },
    {
      "type": "checkbox",
      "id": "Field_Correct_OrganicClaim",
      "key": "details.organicClaim",
      "label": "This product has an organic certification claim",
      "layout": {
        "row": "row_9",
        "columns": null
      },
      "defaultValue": false
    },
    {
      "type": "textfield",
      "id": "Field_Correct_Certificate",
      "key": "details.certificationReference",
      "label": "Certification reference",
      "layout": {
        "row": "row_10",
        "columns": null
      },
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "= details.organicClaim != true"
      }
    },
    {
      "type": "datetime",
      "id": "Field_Correct_Harvest",
      "key": "details.harvestDate",
      "label": "Harvest date (if applicable)",
      "layout": {
        "row": "row_11",
        "columns": null
      },
      "subtype": "date",
      "dateLabel": "Harvest date (if applicable)"
    },
    {
      "type": "datetime",
      "id": "Field_Correct_BestBefore",
      "key": "details.bestBefore",
      "label": "Best before (if applicable)",
      "layout": {
        "row": "row_11",
        "columns": null
      },
      "subtype": "date",
      "dateLabel": "Best before (if applicable)"
    },
    {
      "type": "text",
      "id": "Text_Correct_AllergenHelp",
      "text": "Add the applicable allergens below. Add one allergen per entry.",
      "layout": {
        "row": "row_12",
        "columns": null
      }
    },
    {
      "type": "dynamiclist",
      "id": "List_Correct_Allergens",
      "label": "Allergens",
      "path": "allergenEntries",
      "isRepeating": true,
      "allowAddRemove": true,
      "defaultRepetitions": 0,
      "disableCollapse": true,
      "showOutline": true,
      "layout": {
        "row": "row_13",
        "columns": null
      },
      "components": [
        {
          "type": "textfield",
          "id": "Field_Correct_AllergenName",
          "key": "name",
          "label": "Allergen",
          "layout": {
            "row": "row_14",
            "columns": null
          },
          "validate": {
            "required": true
          }
        }
      ]
    },
    {
      "type": "button",
      "id": "Button_Correct",
      "label": "Resubmit details",
      "action": "submit",
      "layout": {
        "row": "row_15",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "f1-correct-product-proposed",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "schemaVersion": 19,
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "61e4b3b"
  }
}
