<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_F1" targetNamespace="https://desd-group26.example/models" exporter="Camunda Web Modeler" exporterVersion="61e4b3b" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="F1_Collaboration">
    <bpmn:participant id="F1_Pool" name="F1 - Product validation and publication - Initial draft" processRef="F1_Process" />
  </bpmn:collaboration>
  <bpmn:process id="F1_Process" name="F1 - Product validation and publication - Initial draft" isExecutable="false">
    <bpmn:documentation>Initial operational design, 5 November 2026. Tasks describe intended responsibilities. Two Forms are linked to the submission and correction user tasks, with input/output mappings for draft preservation and field normalisation. The process is not deployed; service workers and gateway conditions remain unconfigured. F1 starts with a registered producer using the marketplace workflow. User tasks belong to the producer; service tasks belong to marketplace components. Certification verification calls an external or simulated provider; its checked/failed/unavailable result is an abstract returned status, not a running connector. A pending outcome keeps the listing unpublished and records follow-up; retry timing is deferred. Publication does not imply sale availability: stock and the selling period must still permit sale. Full order and payment processing are excluded.</bpmn:documentation>
    <bpmn:sequenceFlow id="F1_Flow_12" sourceRef="F1_PendingNotify" targetRef="F1_PendingEnd" />
    <bpmn:sequenceFlow id="F1_Flow_11" sourceRef="F1_Pending" targetRef="F1_PendingNotify" />
    <bpmn:sequenceFlow id="F1_Flow_20" sourceRef="F1_Correction" targetRef="F1_Edit" />
    <bpmn:sequenceFlow id="Flow_1hnym9h" sourceRef="Gateway_1tq8q8b" targetRef="F1_Correction" />
    <bpmn:sequenceFlow id="F1_Flow_10" sourceRef="F1_Notify" targetRef="F1_End" />
    <bpmn:sequenceFlow id="F1_Flow_09" sourceRef="F1_Availability" targetRef="F1_Notify" />
    <bpmn:sequenceFlow id="F1_Flow_08" sourceRef="F1_Publish" targetRef="F1_Availability" />
    <bpmn:sequenceFlow id="F1_Flow_07" sourceRef="F1_Ready" targetRef="F1_Publish" />
    <bpmn:sequenceFlow id="Flow_0tt0k2k" name="Invalid certification" sourceRef="F1_Result" targetRef="Gateway_1tq8q8b" />
    <bpmn:sequenceFlow id="F1_Flow_19" name="Unavailable" sourceRef="F1_Result" targetRef="F1_Pending" />
    <bpmn:sequenceFlow id="F1_Flow_16" name="Verified" sourceRef="F1_Result" targetRef="F1_Ready" />
    <bpmn:sequenceFlow id="F1_Flow_06" sourceRef="F1_Verify" targetRef="F1_Result" />
    <bpmn:sequenceFlow id="F1_Flow_15" name="No claim" sourceRef="F1_Claim" targetRef="F1_Ready" />
    <bpmn:sequenceFlow id="F1_Flow_05" name="Yes" sourceRef="F1_Claim" targetRef="F1_Verify" />
    <bpmn:sequenceFlow id="Flow_1ql8ek8" name="No" sourceRef="F1_Valid" targetRef="Gateway_1tq8q8b" />
    <bpmn:sequenceFlow id="F1_Flow_13" name="Yes" sourceRef="F1_Valid" targetRef="F1_Claim" />
    <bpmn:sequenceFlow id="F1_Flow_04" sourceRef="F1_Validate" targetRef="F1_Valid" />
    <bpmn:sequenceFlow id="F1_Flow_03" sourceRef="F1_Entry" targetRef="F1_Validate" />
    <bpmn:sequenceFlow id="F1_Flow_21" name="Resubmitted" sourceRef="F1_Edit" targetRef="F1_Entry" />
    <bpmn:sequenceFlow id="F1_Flow_02" sourceRef="F1_Submit" targetRef="F1_Entry" />
    <bpmn:sequenceFlow id="F1_Flow_01" sourceRef="F1_Start" targetRef="F1_Submit" />
    <bpmn:exclusiveGateway id="Gateway_1tq8q8b">
      <bpmn:incoming>Flow_1ql8ek8</bpmn:incoming>
      <bpmn:incoming>Flow_0tt0k2k</bpmn:incoming>
      <bpmn:outgoing>Flow_1hnym9h</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="F1_PendingEnd" name="Verification follow-up recorded">
      <bpmn:incoming>F1_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="F1_PendingNotify" name="Notify producer of pending status">
      <bpmn:incoming>F1_Flow_11</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="F1_Pending" name="Record pending verification">
      <bpmn:documentation>Keep listing unpublished, record verification failure reason and follow-up state. This is an unresolved business outcome, not successful publication. Retry policy will be designed next week.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_19</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="F1_Edit" name="Correct and resubmit details">
      <bpmn:documentation>Producer corrects the information or certification claim. The initial draft waits for correction; reminder/cancellation policy is not assumed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="f1-correct-product-proposed" />
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:input source="= if lastSubmittedDetails != null then lastSubmittedDetails else details" target="details" />
          <zeebe:input source="= if lastSubmittedAllergenEntries != null then lastSubmittedAllergenEntries else if details.allergens = null then [] else for allergen in details.allergens return {name: allergen}" target="allergenEntries" />
          <zeebe:output source="= details" target="lastSubmittedDetails" />
          <zeebe:output source="= allergenEntries" target="lastSubmittedAllergenEntries" />
          <zeebe:output source="= context merge([{name: details.name, description: details.description, category: details.category, farmOrigin: details.farmOrigin, price: details.price, quantity: details.quantity, startDate: details.startDate, endDate: details.endDate, organicClaim: details.organicClaim = true, allergens: if allergenEntries = null then [] else for entry in allergenEntries return entry.name}, if details.certificationReference = null or details.certificationReference = &#34;&#34; then {} else {certificationReference: details.certificationReference}, if details.harvestDate = null or details.harvestDate = &#34;&#34; then {} else {harvestDate: details.harvestDate}, if details.bestBefore = null or details.bestBefore = &#34;&#34; then {} else {bestBefore: details.bestBefore}])" target="details" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Flow_20</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="F1_Correction" name="Request corrected details">
      <bpmn:documentation>Explain missing or invalid fields or the failed certification claim. Keep listing unpublished. A producer may correct evidence or remove an unsupported organic claim; all submitted information is revalidated.</bpmn:documentation>
      <bpmn:incoming>Flow_1hnym9h</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="F1_End" name="Listing published">
      <bpmn:incoming>F1_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="F1_Notify" name="Notify producer of publication">
      <bpmn:documentation>Send the listing result to the producer. Notification delivery failure handling remains a later implementation concern.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_09</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="F1_Availability" name="Set initial sale availability">
      <bpmn:documentation>Initial availability requires published listing, quantity greater than zero and current business date within the selling period. No sale before the period begins. This calculation is shared with F2.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_08</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F1_Publish" name="Publish validated listing">
      <bpmn:documentation>Only valid required information and a verified claim, or no organic claim, reach publication. Persist product identity and validated details.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_07</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_Ready" name="">
      <bpmn:incoming>F1_Flow_15</bpmn:incoming>
      <bpmn:incoming>F1_Flow_16</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="F1_Result" name="Verification outcome?">
      <bpmn:incoming>F1_Flow_06</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>F1_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_0tt0k2k</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F1_Verify" name="Check certification with provider">
      <bpmn:documentation>External or simulated certification verification. Return one of verified, invalid, unavailable; unavailable includes timeout. No connector or worker exists yet. Do not treat an outage as a failed certificate.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_05</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_Claim" name="Organic claim?">
      <bpmn:incoming>F1_Flow_13</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_05</bpmn:outgoing>
      <bpmn:outgoing>F1_Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="F1_Valid" name="Information valid?">
      <bpmn:incoming>F1_Flow_04</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ql8ek8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F1_Validate" name="Validate required information">
      <bpmn:documentation>Marketplace validates required fields, applicable information, quantity and price ranges and date ordering. Exact field-level constraints need group review. Corrected information is revalidated.</bpmn:documentation>
      <bpmn:incoming>F1_Flow_03</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_Entry" name="">
      <bpmn:incoming>F1_Flow_02</bpmn:incoming>
      <bpmn:incoming>F1_Flow_21</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="F1_Submit" name="Submit product details">
      <bpmn:documentation>Registered producer enters name, description, category, price, quantity, availability period, farm origin and applicable harvest, allergen, organic certification and best-before information. Authentication is a precondition, not implemented in this draft.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="f1-submit-product-proposed" />
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:input source="= if details = null then {organicClaim: false} else details" target="details" />
          <zeebe:input source="= if details.allergens = null then [] else for allergen in details.allergens return {name: allergen}" target="allergenEntries" />
          <zeebe:output source="= details" target="lastSubmittedDetails" />
          <zeebe:output source="= allergenEntries" target="lastSubmittedAllergenEntries" />
          <zeebe:output source="= context merge([{name: details.name, description: details.description, category: details.category, farmOrigin: details.farmOrigin, price: details.price, quantity: details.quantity, startDate: details.startDate, endDate: details.endDate, organicClaim: details.organicClaim = true, allergens: if allergenEntries = null then [] else for entry in allergenEntries return entry.name}, if details.certificationReference = null or details.certificationReference = &#34;&#34; then {} else {certificationReference: details.certificationReference}, if details.harvestDate = null or details.harvestDate = &#34;&#34; then {} else {harvestDate: details.harvestDate}, if details.bestBefore = null or details.bestBefore = &#34;&#34; then {} else {bestBefore: details.bestBefore}])" target="details" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Flow_01</bpmn:incoming>
      <bpmn:outgoing>F1_Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="F1_Start" name="Listing started">
      <bpmn:outgoing>F1_Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
