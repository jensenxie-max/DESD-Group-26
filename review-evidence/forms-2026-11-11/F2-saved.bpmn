        <dc:Bounds x="2275" y="420" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Sync_di" bpmnElement="F2_Sync">
        <dc:Bounds x="2065" y="420" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Saved_di" bpmnElement="F2_Saved" isMarkerVisible="true">
        <dc:Bounds x="1965" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1910" y="393" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Save_di" bpmnElement="F2_Save">
        <dc:Bounds x="1755" y="420" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_StateMerge_di" bpmnElement="F2_StateMerge" isMarkerVisible="true">
        <dc:Bounds x="1655" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1815" y="433" width="160" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Unavailable_di" bpmnElement="F2_Unavailable">
        <dc:Bounds x="1445" y="550" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Available_di" bpmnElement="F2_Available">
        <dc:Bounds x="1445" y="290" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_CanSell_di" bpmnElement="F2_CanSell" isMarkerVisible="true">
        <dc:Bounds x="1335" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1340" y="513" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Assess_di" bpmnElement="F2_Assess">
        <dc:Bounds x="1125" y="420" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Merge_di" bpmnElement="F2_Merge" isMarkerVisible="true">
        <dc:Bounds x="1025" y="435" width="50" height="50" />
