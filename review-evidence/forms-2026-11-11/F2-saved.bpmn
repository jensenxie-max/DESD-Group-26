<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_F2" targetNamespace="https://desd-group26.example/models" exporter="Camunda Web Modeler" exporterVersion="61e4b3b" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="F2_Collaboration">
    <bpmn:participant id="F2_Pool" name="F2 - Inventory and seasonal availability - Initial draft" processRef="F2_Process" />
  </bpmn:collaboration>
  <bpmn:process id="F2_Process" name="F2 - Inventory and seasonal availability - Initial draft" isExecutable="false">
    <bpmn:documentation>Initial operational design, 5 November 2026. Tasks describe intended responsibilities. Draft user-task form binding and data mappings are configured; service workers, executable expressions and deployment remain pending. Inputs come from a producer quantity/date update, a confirmed-order stock-change message, or a proposed seasonal recheck. Full checkout/payment are outside F2. Producer stock updates use an absolute non-negative quantity; orders use a positive deduction and unique order-change ID. No database or event system is implemented. Seasonal scheduling, idempotency, atomic version checks and fail-closed customer visibility on persistence/synchronisation failure are proposals to validate before implementation. Stock alone must never republish an unvalidated listing.</bpmn:documentation>
    <bpmn:sequenceFlow id="F2_Flow_13" sourceRef="F2_Failed" targetRef="F2_FailedEnd" />
    <bpmn:sequenceFlow id="F2_Flow_12" sourceRef="F2_Notify" targetRef="F2_End" />
    <bpmn:sequenceFlow id="F2_Flow_11" sourceRef="F2_Sync" targetRef="F2_Notify" />
    <bpmn:sequenceFlow id="F2_Flow_29" name="No / conflict" sourceRef="F2_Saved" targetRef="F2_Failed" />
    <bpmn:sequenceFlow id="F2_Flow_28" name="Yes" sourceRef="F2_Saved" targetRef="F2_Sync" />
    <bpmn:sequenceFlow id="F2_Flow_10" sourceRef="F2_Save" targetRef="F2_Saved" />
    <bpmn:sequenceFlow id="F2_Flow_09" sourceRef="F2_StateMerge" targetRef="F2_Save" />
    <bpmn:sequenceFlow id="F2_Flow_27" sourceRef="F2_Unavailable" targetRef="F2_StateMerge" />
    <bpmn:sequenceFlow id="F2_Flow_26" sourceRef="F2_Available" targetRef="F2_StateMerge" />
    <bpmn:sequenceFlow id="F2_Flow_25" name="No" sourceRef="F2_CanSell" targetRef="F2_Unavailable" />
    <bpmn:sequenceFlow id="F2_Flow_24" name="Yes" sourceRef="F2_CanSell" targetRef="F2_Available" />
    <bpmn:sequenceFlow id="F2_Flow_08" sourceRef="F2_Assess" targetRef="F2_CanSell" />
    <bpmn:sequenceFlow id="F2_Flow_07" sourceRef="F2_Merge" targetRef="F2_Assess" />
    <bpmn:sequenceFlow id="F2_Flow_23" sourceRef="F2_Season" targetRef="F2_Merge" />
    <bpmn:sequenceFlow id="F2_Flow_06" sourceRef="F2_RejectOrder" targetRef="F2_OrderEnd" />
    <bpmn:sequenceFlow id="F2_Flow_22" sourceRef="F2_Deduct" targetRef="F2_Merge" />
    <bpmn:sequenceFlow id="F2_Flow_20" name="No / already applied" sourceRef="F2_OrderValid" targetRef="F2_RejectOrder" />
    <bpmn:sequenceFlow id="F2_Flow_19" name="Yes" sourceRef="F2_OrderValid" targetRef="F2_Deduct" />
    <bpmn:sequenceFlow id="F2_Flow_04" sourceRef="F2_Order" targetRef="F2_OrderValid" />
    <bpmn:sequenceFlow id="F2_Flow_05" sourceRef="F2_RejectInput" targetRef="F2_InputEnd" />
    <bpmn:sequenceFlow id="F2_Flow_21" sourceRef="F2_Prepare" targetRef="F2_Merge" />
    <bpmn:sequenceFlow id="F2_Flow_18" name="No" sourceRef="F2_InputValid" targetRef="F2_RejectInput" />
    <bpmn:sequenceFlow id="F2_Flow_17" name="Yes" sourceRef="F2_InputValid" targetRef="F2_Prepare" />
    <bpmn:sequenceFlow id="F2_Flow_03" sourceRef="F2_Producer" targetRef="F2_InputValid" />
    <bpmn:sequenceFlow id="F2_Flow_16" name="Seasonal recheck (proposal)" sourceRef="F2_Source" targetRef="F2_Season" />
    <bpmn:sequenceFlow id="F2_Flow_15" name="Confirmed order" sourceRef="F2_Source" targetRef="F2_Order" />
    <bpmn:sequenceFlow id="F2_Flow_14" name="Producer update" sourceRef="F2_Source" targetRef="F2_EnterStockChange" />
    <bpmn:sequenceFlow id="F2_Flow_30" sourceRef="F2_EnterStockChange" targetRef="F2_Producer" />
    <bpmn:sequenceFlow id="F2_Flow_02" sourceRef="F2_Load" targetRef="F2_Source" />
    <bpmn:sequenceFlow id="F2_Flow_01" sourceRef="F2_Start" targetRef="F2_Load" />
    <bpmn:endEvent id="F2_FailedEnd" name="Update needs follow-up">
      <bpmn:incoming>F2_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="F2_Failed" name="Record failure; arrange follow-up">
      <bpmn:documentation>On unconfirmed write, do not claim success or synchronise speculative values. Record retry/manual follow-up. Atomic failure leaves previous state unchanged; seasonal or stale-visibility risks require authoritative checkout checks and explicit handling in implementation.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_29</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F2_End" name="Availability update handled">
      <bpmn:incoming>F2_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="F2_Notify" name="Return update result">
      <bpmn:incoming>F2_Flow_11</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="F2_Sync" name="Synchronise customer availability">
      <bpmn:documentation>Update the customer-facing view from committed state and version. This draft abstracts delivery/retry; a failed or stale view must not permit an order without a fresh stock check. Integration is not implemented.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_28</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F2_Saved" name="Commit confirmed?">
      <bpmn:incoming>F2_Flow_10</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_28</bpmn:outgoing>
      <bpmn:outgoing>F2_Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F2_Save" name="Commit stock and status atomically">
      <bpmn:documentation>Proposed transaction saves quantity, dates, availability, audit and order-change ID using expected version. Failure must not expose an uncommitted update. The database/worker implementation is next-week work.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_09</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F2_StateMerge" name="">
      <bpmn:incoming>F2_Flow_26</bpmn:incoming>
      <bpmn:incoming>F2_Flow_27</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F2_Unavailable" name="Prepare UNAVAILABLE status">
      <bpmn:incoming>F2_Flow_25</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F2_Available" name="Prepare AVAILABLE status">
      <bpmn:incoming>F2_Flow_24</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F2_CanSell" name="Eligible for sale?">
      <bpmn:incoming>F2_Flow_08</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_24</bpmn:outgoing>
      <bpmn:outgoing>F2_Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F2_Assess" name="Assess publication, stock and dates">
      <bpmn:documentation>Available only if product is published, proposed quantity &gt; 0, and start &lt;= businessDate &lt;= end. Zero stock, future season, expired season or unpublished product all yield unavailable. Date boundary inclusivity is an explicit design assumption.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_07</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F2_Merge" name="">
      <bpmn:incoming>F2_Flow_21</bpmn:incoming>
      <bpmn:incoming>F2_Flow_22</bpmn:incoming>
      <bpmn:incoming>F2_Flow_23</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F2_Season" name="Keep stock; recheck sale dates">
      <bpmn:documentation>Proposed seasonal-boundary trigger. Keep stored stock and dates; recompute availability. Scheduling frequency, business timezone and inclusive date boundaries require group review. Not a running timer.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_16</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F2_OrderEnd" name="Order change not applied">
      <bpmn:incoming>F2_Flow_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="F2_RejectOrder" name="Record rejected / duplicate change">
      <bpmn:documentation>Do not change stock for an invalid, duplicate or insufficient-stock request. Return distinct duplicate-already-applied, rejected or retry-required outcomes to the order integration. Full order processing remains outside F2.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_20</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F2_Deduct" name="Calculate remaining stock">
      <bpmn:documentation>Proposed new quantity = current quantity - confirmed-order deduction. This task calculates only; an atomic commit must recheck version and uniqueness to prevent double deduction.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_19</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F2_OrderValid" name="Order change applicable?">
      <bpmn:incoming>F2_Flow_04</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>F2_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F2_Order" name="Check confirmed order change">
      <bpmn:documentation>Accept confirmed-order input only, require a positive deduction, a unique change ID, and enough current stock. Duplicate change IDs must not deduct again. An atomic commit/version check is proposed for concurrent updates.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_15</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F2_InputEnd" name="Correction requested">
      <bpmn:incoming>F2_Flow_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="F2_RejectInput" name="Request corrected stock / dates">
      <bpmn:documentation>Reject invalid input without changing stored stock or availability; producer resubmission starts a new request.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_18</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="F2_Prepare" name="Prepare producer stock / date change">
      <bpmn:documentation>Prepare new quantity and/or date range without changing publication approval. Restocking is a producer quantity update. Do not subtract from an absolute producer stock value.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_17</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F2_InputValid" name="Producer input valid?">
      <bpmn:incoming>F2_Flow_03</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_17</bpmn:outgoing>
      <bpmn:outgoing>F2_Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="F2_EnterStockChange" name="Enter stock and sale dates">
      <bpmn:documentation>Collect an absolute stock quantity and sale dates on the producer branch. Pre-fill from the loaded product; keep edits separate from stored product until validation and commit. The expected version comes from the loaded product, not editable form data. Product lookup and the producer source must be supplied before this task. Ownership validation remains a service responsibility. Form binding and mappings require runtime verification.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f2-stock-dates-proposed" />
        <zeebe:ioMapping>
          <zeebe:input source="= product.version" target="loadedVersion" />
          <zeebe:input source="= {productId: productId, quantity: product.quantity, version: loadedVersion}" target="display" />
          <zeebe:input source="= product.quantity" target="producerQuantity" />
          <zeebe:input source="= product.startDate" target="producerStartDate" />
          <zeebe:input source="= product.endDate" target="producerEndDate" />
          <zeebe:output source="= &#34;producer&#34;" target="update.source" />
          <zeebe:output source="= producerQuantity" target="update.quantity" />
          <zeebe:output source="= producerStartDate" target="update.startDate" />
          <zeebe:output source="= producerEndDate" target="update.endDate" />
          <zeebe:output source="= loadedVersion" target="update.expectedVersion" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2_Flow_14</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="F2_Producer" name="Validate producer quantity / dates">
      <bpmn:documentation>Producer owns the product. Proposed quantity is an absolute value, non-negative, and conforms to the product unit. Start date cannot exceed end date. No database write yet.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_30</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F2_Source" name="Update source?">
      <bpmn:incoming>F2_Flow_02</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>F2_Flow_15</bpmn:outgoing>
      <bpmn:outgoing>F2_Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F2_Load" name="Read product and current stock">
      <bpmn:documentation>Read product publication state, quantity, sale dates, version and already-processed order-change IDs. Product lookup failure requires follow-up before any mutation.</bpmn:documentation>
      <bpmn:incoming>F2_Flow_01</bpmn:incoming>
      <bpmn:outgoing>F2_Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="F2_Start" name="Update received">
      <bpmn:outgoing>F2_Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="F2_Diagram">
    <bpmndi:BPMNPlane id="F2_Plane" bpmnElement="F2_Collaboration">
      <bpmndi:BPMNShape id="F2_Pool_di" bpmnElement="F2_Pool" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2630" height="960" />
      </bpmndi:BPMNShape>
