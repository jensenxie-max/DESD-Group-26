          <dc:Bounds x="1155" y="433" width="160" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Season_di" bpmnElement="F2_Season">
        <dc:Bounds x="760" y="830" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_OrderEnd_di" bpmnElement="F2_OrderEnd">
        <dc:Bounds x="982" y="642" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="927" y="699" width="146" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
