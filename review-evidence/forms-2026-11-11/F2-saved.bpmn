          <dc:Bounds x="605" y="393" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Order_di" bpmnElement="F2_Order">
        <dc:Bounds x="450" y="420" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_InputEnd_di" bpmnElement="F2_InputEnd">
        <dc:Bounds x="982" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="927" y="107" width="146" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_RejectInput_di" bpmnElement="F2_RejectInput">
        <dc:Bounds x="760" y="30" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Prepare_di" bpmnElement="F2_Prepare">
        <dc:Bounds x="760" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_InputValid_di" bpmnElement="F2_InputValid" isMarkerVisible="true">
        <dc:Bounds x="660" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="605" y="253" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_EnterStockChange_di" bpmnElement="F2_EnterStockChange">
        <dc:Bounds x="295" y="275" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Producer_di" bpmnElement="F2_Producer">
        <dc:Bounds x="450" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Source_di" bpmnElement="F2_Source" isMarkerVisible="true">
        <dc:Bounds x="350" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="205" y="513" width="160" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Load_di" bpmnElement="F2_Load">
        <dc:Bounds x="140" y="420" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_Start_di" bpmnElement="F2_Start">
        <dc:Bounds x="60" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="15" y="508" width="146" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
